@pytest.mark.unit
class TestDeliverableService:
    """Unit tests for DeliverableService."""

    @pytest.fixture
    def deliverable_service(self, db_session, mock_event_bus):
        """Create DeliverableService instance."""
        return DeliverableService(db_session=db_session, event_bus=mock_event_bus)

    @pytest.mark.asyncio
    async def test_create_deliverable(self, mock_event_bus):
        """Test creating a new deliverable."""
        # Create a mock database session and service
        mock_db_session = AsyncMock()
        deliverable_service = DeliverableService(
            db_session=mock_db_session, event_bus=mock_event_bus
        )

        # Create a test project
        test_project = Project(
            id=uuid4(), name="Test Project", business_id=1, created_by=1
        )

        # Use the correct parameters for create_deliverable
        deliverable_type = DeliverableType.RENDERED_IMAGES
        tentative_timeline = 30

        # Mock the project existence check
        with patch.object(mock_db_session, "execute") as mock_execute, patch.object(
            mock_db_session, "add"
        ) as mock_add, patch.object(
            mock_db_session, "commit"
        ) as mock_commit, patch.object(
            mock_db_session, "refresh"
        ) as mock_refresh:
            # Mock the project existence check
            mock_project_result = Mock()
            mock_project_result.scalar_one_or_none.return_value = test_project
            mock_execute.return_value = mock_project_result

            result = await deliverable_service.create_deliverable(
                project_id=test_project.id,
                deliverable_type=deliverable_type,
                deliverable_sub_type="Interior",
                tentative_timeline_days=tentative_timeline,
            )

            assert result.deliverable_type == deliverable_type
            assert result.project_id == test_project.id
            mock_add.assert_called_once()
            mock_commit.assert_called_once()

    @pytest.mark.asyncio
    async def test_get_deliverables_by_project(self, mock_event_bus):
        """Test retrieving deliverables by project."""
        # Create a mock database session and service
        mock_db_session = AsyncMock()
        deliverable_service = DeliverableService(
            db_session=mock_db_session, event_bus=mock_event_bus
        )

        # Create a test project
        test_project = Project(
            id=uuid4(), name="Test Project", business_id=1, created_by=1
        )

        # Create mock deliverables
        mock_deliverables = [
            Deliverable(
                deliverable_type=DeliverableType.RENDERED_IMAGES,
                project_id=test_project.id,
            ),
            Deliverable(
                deliverable_type=DeliverableType.TECHNICAL_RENDERS,
                project_id=test_project.id,
            ),
        ]

        with patch.object(mock_db_session, "execute") as mock_execute:
            # Mock the database result
            mock_result = Mock()
            mock_result.scalars.return_value.all.return_value = mock_deliverables
            mock_execute.return_value = mock_result

            result = await deliverable_service.get_deliverables_for_project(
                test_project.id
            )

            assert len(result) == 2
            assert all(d.project_id == test_project.id for d in result)
            mock_execute.assert_called_once()

