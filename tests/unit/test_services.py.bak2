@pytest.mark.unit
class TestProjectService:
    """Unit tests for ProjectService."""

    @pytest.mark.asyncio
    @pytest.mark.asyncio
    async def test_create_new_project(self, mock_event_bus):
        """Test creating a new project."""
        # Create a mock database session
        mock_db_session = AsyncMock()

        # Create service instance with mocked session
        project_service = ProjectService(
            db_session=mock_db_session, event_bus=mock_event_bus
        )

        project_data = {
            "name": "Test Project",
            "budget": 50000.00,
            "start_date": date.today().isoformat(),
            "end_date": date.today().replace(year=date.today().year + 1).isoformat(),
        }

        # Create the project
        result = await project_service.create_new_project(**project_data)

        # Verify the project was created correctly
        assert result.name == project_data["name"]
        assert result.budget == project_data["budget"]

        # Verify database operations were called
        mock_db_session.add.assert_called_once()
        mock_db_session.commit.assert_called_once()
        mock_db_session.refresh.assert_called_once()

        # Verify event was published
        mock_event_bus.publish.assert_called_once()

    @pytest.mark.asyncio
    async def test_get_project_by_id(self, mock_event_bus):
        """Test retrieving project by ID."""
        # Create a mock database session
        mock_db_session = AsyncMock()
        project_service = ProjectService(
            db_session=mock_db_session, event_bus=mock_event_bus
        )

        # Create a test project
        test_project = Project(
            id=uuid4(), name="Test Project", business_id=1, created_by=1
        )

        with patch.object(mock_db_session, "execute") as mock_execute:
            # Mock the result object that execute() returns
            mock_result = Mock()
            mock_result.scalar_one_or_none.return_value = test_project
            mock_execute.return_value = mock_result

            result = await project_service.get_project_by_id(test_project.id)

            assert result == test_project
            mock_execute.assert_called_once()

    @pytest.mark.asyncio
    async def test_get_project_by_id_not_found(self, mock_event_bus):
        """Test retrieving non-existent project."""
        # Create a mock database session
        mock_db_session = AsyncMock()
        project_service = ProjectService(
            db_session=mock_db_session, event_bus=mock_event_bus
        )

        non_existent_id = uuid4()

        with patch.object(mock_db_session, "execute") as mock_execute:
            # Mock the result object that execute() returns
            mock_result = Mock()
            mock_result.scalar_one_or_none.return_value = None  # No project found
            mock_execute.return_value = mock_result

            result = await project_service.get_project_by_id(non_existent_id)

            assert result is None
            mock_execute.assert_called_once()

