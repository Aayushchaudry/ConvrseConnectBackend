        # This test should be implemented when the method is added to the service
        pytest.skip(
            "assign_task_to_team_member method not implemented in ProductionManagementService yet"
        )

    @pytest.mark.asyncio
    async def test_update_task_progress(self, mock_event_bus):
        """Test updating task progress."""
        mock_db_session = AsyncMock()
        production_service = ProductionManagementService(
            db_session_factory=lambda: mock_db_session, event_bus=mock_event_bus
        )

        test_task_id = uuid4()
        project_id = uuid4()
        deliverable_id = uuid4()

        test_task = InternalTask(
            id=test_task_id,
            status=TaskStatus.TODO,
            project_id=project_id,
            deliverable_id=deliverable_id,
        )

        with patch(
            "src.services.production_management_service.ProductionManagementService._get_task_by_id",
            new_callable=AsyncMock,
            return_value=test_task,
        ) as mock_get_task:
            update_command = UpdateInternalTaskStatusCommand(
                task_id=test_task_id,
                new_status=TaskStatus.IN_PROGRESS.value,
                project_id=project_id,
                deliverable_id=deliverable_id,
            )

            updated_task = (
                await production_service.handle_update_internal_task_status_command(
                    update_command
                )
            )

            # Assert that the service returned the updated task
            assert updated_task is not None
            assert updated_task.status == TaskStatus.IN_PROGRESS

            # Verify that the session was used to get the task and commit the change
            mock_get_task.assert_awaited_once()
            assert mock_get_task.call_args[0][1] == test_task_id

            # Verify that an event was published
            mock_event_bus.publish.assert_called_once()


@pytest.mark.unit
class TestReviewManagementService:
    """Unit tests for ReviewManagementService."""

    @pytest.fixture
    def review_service(self, db_session, mock_event_bus):
        """Create ReviewManagementService instance."""
        return ReviewManagementService(
            db_session_factory=lambda: db_session, event_bus=mock_event_bus
        )

    @pytest.mark.asyncio
    async def test_create_review_item(self, review_service, test_deliverable):
        """Test creating a review item for a deliverable."""
        deliverable = test_deliverable
        service = review_service
        db_session = service.db_session_factory()

        # Mock the service's method that creates the review item
        with patch.object(
            service, "handle_generate_review_item_command", new_callable=AsyncMock
        ) as mock_create_review_item:
            # Prepare a command to pass to the service
            command = MagicMock()
            command.deliverable_id = deliverable.id
            command.project_id = deliverable.project_id
            command.review_item_type = ReviewItemType.TECHNICAL_MODEL.value
            command.asset_urls = ["http://example.com/asset.png"]

            await service.handle_generate_review_item_command(command)

            mock_create_review_item.assert_awaited_once_with(command)

    @pytest.mark.asyncio
    async def test_submit_review_feedback(self, review_service, mock_event_bus):
        """Test submitting feedback for a review item."""
        service = review_service
        db_session = service.db_session_factory()
        review_id = uuid4()
        mock_review = ReviewItem(
            id=review_id,
            deliverable_id=uuid4(),
            project_id=uuid4(),
            source_internal_task_id=uuid4(),
            item_type=ReviewItemType.TECHNICAL_MODEL,
            item_url="http://example.com/model.glb",
            review_status=ReviewStatus.PENDING,
        )

        feedback_event = ClientFeedbackSubmittedEvent(
            review_item_id=review_id,
            project_id=mock_review.project_id,
            deliverable_id=mock_review.deliverable_id,
            client_user_id=1,
            feedback_type=FeedbackType.ACCEPT.value,
        )

        with patch.object(db_session, "get", new_callable=AsyncMock) as mock_get:
            mock_get.return_value = mock_review

            await service.handle_client_feedback_submitted(event=feedback_event)

            # Assert that the review item's status was updated
            mock_get.assert_awaited_with(ReviewItem, review_id)

            # Verify that the review_item's status has been updated in the mock object
            assert mock_review.review_status == ReviewStatus.ACCEPTED

            # Verify that an event was published
            mock_event_bus.publish.assert_called_once()

    @pytest.mark.asyncio
    async def test_get_pending_reviews(self, review_service):
        """Test getting pending reviews for a reviewer."""
        reviewer_id = 1
        mock_reviews = [
            ReviewItem(
                description="Review 1",
                deliverable_id=uuid4(),
                reviewer_id=reviewer_id,
                status=ReviewStatus.PENDING,
            ),
            ReviewItem(
                description="Review 2",
                deliverable_id=uuid4(),
                reviewer_id=reviewer_id,
                status=ReviewStatus.PENDING,
            ),
        ]

        with patch.object(review_service, "get_reviews_by_reviewer") as mock_get:
            mock_get.return_value = mock_reviews

            result = await review_service.get_pending_reviews(reviewer_id)

            assert len(result) == 2
            assert all(r.status == ReviewStatus.PENDING for r in result)


@pytest.mark.unit
class TestDeliveryService:
    """Unit tests for DeliveryService."""

    @pytest.fixture
    def delivery_service(self, db_session, mock_event_bus):
        """Create DeliveryService instance."""
        return DeliveryService(
            db_session_factory=lambda: db_session, event_bus=mock_event_bus
        )

    @pytest.mark.asyncio
    async def test_prepare_delivery_package(self, delivery_service, test_project):
        """Test preparing the final delivery package for a project."""
        project = test_project
        delivery_service_instance = delivery_service
        # Test setup
        with patch.object(
            delivery_service_instance, "package_project_for_delivery"
        ) as mock_package:
            mock_package.return_value = {
                "status": "success",
                "package_path": "/tmp/package.zip",
            }

            # Call the method
            result = await delivery_service_instance.package_project_for_delivery(
                project.id
            )

            # Assertions
            assert result["status"] == "success"
            mock_package.assert_awaited_once_with(project.id)

    @pytest.mark.asyncio
    async def test_schedule_client_presentation(self, delivery_service, test_project):
        """Test scheduling a client presentation."""
        # Test setup
        project = test_project
        delivery_service_instance = delivery_service
        presentation_time = datetime.now()

        with patch.object(
            delivery_service_instance, "schedule_presentation"
        ) as mock_schedule:
            mock_schedule.return_value = {
                "status": "scheduled",
                "presentation_id": uuid4(),
            }

            # Call the method
            result = await delivery_service_instance.schedule_presentation(
                project.id, presentation_time
            )

            # Assertions
            assert result["status"] == "scheduled"
            mock_schedule.assert_awaited_once_with(project.id, presentation_time)

    @pytest.mark.asyncio
    async def test_finalize_project_delivery(self, delivery_service, test_project):
        """Test finalizing project delivery and archiving."""
        # Test setup
        project = test_project
        delivery_service_instance = delivery_service
        with patch.object(
            delivery_service_instance, "finalize_delivery"
        ) as mock_finalize:
            mock_finalize.return_value = {"status": "completed", "archived": True}

            # Call the method
            result = await delivery_service_instance.finalize_delivery(project.id)

            # Assertions
            assert result["status"] == "completed"
            mock_finalize.assert_awaited_once_with(project.id)


@pytest.mark.unit
class TestActivityLoggerService:
    """Unit tests for ActivityLoggerService."""

    @pytest.fixture
    def mock_auth_context(self):
        """Create mock authentication context."""
        from unittest.mock import Mock

        auth_context = Mock()
        auth_context.is_authenticated = True
        auth_context.user_id = 1
        auth_context.business_id = 1
        auth_context.correlation_id = "test-correlation-id"
        auth_context.user.businesses = [{"business_id": 1}]
        return auth_context

    @pytest.mark.asyncio
    @pytest.mark.asyncio
    async def test_log_activity(self, mock_auth_context):
        """Test logging an activity with ActivityLoggerService."""
        with patch(
            "src.services.activity_logger.AsyncSessionLocal"
        ) as mock_session_local, patch(
            "src.services.activity_logger.get_auth_client"
        ) as mock_get_auth_client:
            # Mock the session
            mock_session = AsyncMock()
            mock_session_local.return_value.__aenter__.return_value = mock_session

            # Mock auth client
            mock_auth_client = AsyncMock()
            mock_get_auth_client.return_value = mock_auth_client

            await ActivityLoggerService.log_activity(
                auth_context=mock_auth_context,
                action="project_created",
                resource_type="project",
                resource_id="test-project-id",
                details={"test": "data"},
            )

            # Verify session operations
            mock_session.add.assert_called_once()
            mock_session.commit.assert_called_once()

            # Verify the ActivityLog was created with correct data
            activity_log_call = mock_session.add.call_args[0][0]
            assert activity_log_call.action == "project_created"
            assert activity_log_call.resource_type == "project"
            assert activity_log_call.resource_id == "test-project-id"
            assert activity_log_call.user_id == 1
            assert activity_log_call.business_id == 1

    @pytest.mark.asyncio
    @pytest.mark.asyncio
    async def test_log_activity_unauthenticated(self):
        """Test that unauthenticated users don't get logged."""
        from unittest.mock import Mock

        auth_context = Mock()
        auth_context.is_authenticated = False

        with patch(
            "src.services.activity_logger.AsyncSessionLocal"
        ) as mock_session_local:
            await ActivityLoggerService.log_activity(
                auth_context=auth_context,
                action="project_created",
                resource_type="project",
            )

            # Should not create session if not authenticated
            mock_session_local.assert_not_called()

    @pytest.mark.asyncio
    @pytest.mark.asyncio
    async def test_convenience_functions(self, mock_auth_context):
        """Test convenience functions for different resource types."""
        from src.services.activity_logger import (
            log_deliverable_activity,
            log_project_activity,
        )

        with patch.object(ActivityLoggerService, "log_activity") as mock_log:
            # Test project activity logging
            await log_project_activity(
                auth_context=mock_auth_context,
                action="created",
                project_id="test-project-id",
            )

            mock_log.assert_called_with(
                auth_context=mock_auth_context,
                action="created",
                resource_type="project",
                resource_id="test-project-id",
                details=None,
                request=None,
            )

            # Test deliverable activity logging
            await log_deliverable_activity(
                auth_context=mock_auth_context,
                action="updated",
                deliverable_id="test-deliverable-id",
            )

            mock_log.assert_called_with(
                auth_context=mock_auth_context,
                action="updated",
                resource_type="deliverable",
                resource_id="test-deliverable-id",
                details=None,
                request=None,
            )


