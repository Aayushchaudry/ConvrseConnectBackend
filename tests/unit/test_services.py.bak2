@pytest.mark.unit
class TestServiceErrorHandling:
    """Unit tests for service error handling."""

    @pytest.mark.asyncio
    async def test_project_service_database_error(self, db_session, mock_event_bus):
        """Test project service handles database errors."""
        project_service = ProjectService(
            db_session=db_session, event_bus=mock_event_bus
        )

        with patch.object(db_session, "add", side_effect=Exception("Database error")):
            with pytest.raises(Exception):
                await project_service.create_new_project(
                    name="Test Project",
                    budget=50000.00,
                    start_date=date.today().isoformat(),
                    end_date=date.today().isoformat(),
                )

    @pytest.mark.asyncio
    async def test_deliverable_service_validation_error(
        self, db_session, mock_event_bus
    ):
        """Test deliverable service handles validation errors."""
        deliverable_service = DeliverableService(
            db_session=db_session, event_bus=mock_event_bus
        )

        # Test with invalid data
        with pytest.raises(Exception):
            await deliverable_service.create_deliverable(
                name="",  # Empty name should cause validation error
                type=DeliverableType.RENDERED_IMAGES,
                project_id=uuid4(),
            )

    @pytest.mark.asyncio
    async def test_service_event_bus_error(self, db_session):
        """Test service handles event bus errors gracefully."""
        mock_event_bus = AsyncMock()
        mock_event_bus.publish.side_effect = Exception("Event bus error")

        project_service = ProjectService(
            db_session=db_session, event_bus=mock_event_bus
        )

        # Service should handle event bus errors without failing
        with patch.object(project_service, "create_new_project") as mock_create:
            mock_project = Project(name="Test", business_id=1, created_by=1)
            mock_create.return_value = mock_project

            # Should not raise exception even if event publishing fails
            try:
                result = await project_service.create_new_project(
                    name="Test Project",
                    budget=50000.00,
                    start_date=date.today().isoformat(),
                    end_date=date.today().isoformat(),
                )
                # Event publishing might fail, but project creation should succeed
                assert result.name == "Test"
            except Exception as e:
                # If it does raise, it should be handled gracefully
                assert "Event bus error" in str(e)


@pytest.mark.unit
class TestServiceIntegration:
    """Unit tests for service integration and dependencies."""

    @pytest.mark.asyncio
    async def test_services_can_be_instantiated_together(
        self, db_session, mock_event_bus
    ):
        """Test that all services can be instantiated together."""
        services = {
            "project": ProjectService(db_session=db_session, event_bus=mock_event_bus),
            "deliverable": DeliverableService(
                db_session=db_session, event_bus=mock_event_bus
            ),
            "info_gathering": InformationGatheringService(
                db_session_factory=lambda: db_session, event_bus=mock_event_bus
            ),
            "production": ProductionManagementService(
                db_session_factory=lambda: db_session, event_bus=mock_event_bus
            ),
            "review": ReviewManagementService(
                db_session_factory=lambda: db_session, event_bus=mock_event_bus
            ),
            "delivery": DeliveryService(
                db_session_factory=lambda: db_session, event_bus=mock_event_bus
            ),
            "activity_logger": ActivityLoggerService,
            # "auth": AuthService(),  # Not implemented yet
            # "util": UtilService(),  # Not implemented yet
        }

        assert len(services) == 7  # AuthService and UtilService not implemented yet
        assert all(service is not None for service in services.values())

    @pytest.mark.asyncio
    async def test_service_dependency_injection(self, db_session, mock_event_bus):
        """Test that services properly receive their dependencies."""
        project_service = ProjectService(
            db_session=db_session, event_bus=mock_event_bus
        )

        assert project_service.db_session == db_session
        assert project_service.event_bus == mock_event_bus

    @pytest.mark.asyncio
    async def test_service_shared_session(self, db_session, mock_event_bus):
        """Test that services can share the same database session."""
        project_service = ProjectService(
            db_session=db_session, event_bus=mock_event_bus
        )
        deliverable_service = DeliverableService(
            db_session=db_session, event_bus=mock_event_bus
        )

        assert project_service.db_session is deliverable_service.db_session
