# .env
# --- APPLICATION SETTINGS ---
APP_NAME="3D Project Portal Backend"
ENV="development"
DEBUG=True # Set to False in production

# --- DATABASE SETTINGS ---
# IMPORTANT: USE THE EXACT SAME USER AND PASSWORD AS IN docker-compose.yml
DATABASE_URL=postgresql+asyncpg://ConvrseConnect:ConvrseConnect123@localhost:5433/project_db

# --- EVENT BUS SETTINGS ---
ACTIVE_EVENT_BUS="kafka" # Set to "sqs_mock" if you want to test the SQS placeholder

# Kafka specific settings
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_CLIENT_ID="project-portal-backend"
KAFKA_CONSUMER_GROUP_ID="project-portal-group"
KAFKA_RETRIES=5
KAFKA_LINGER_MS=10

# AWS SQS specific settings (uncomment and fill if using SQS and want to test real connection later)
# AWS_REGION="ap-south-1"
# AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
# AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"