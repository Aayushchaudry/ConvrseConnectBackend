# Development Dockerfile for ConvrseConnectBackend
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies with retry logic for fresh machines
RUN set -ex && \
    # Update package lists with retry
    for i in 1 2 3; do \
        apt-get update && break || { \
            echo "Attempt $i: apt-get update failed, retrying in 10 seconds..."; \
            sleep 10; \
            # Clean package lists and try again
            rm -rf /var/lib/apt/lists/*; \
        } \
    done && \
    # Install packages with retry logic
    for i in 1 2 3; do \
        apt-get install -y \
            gcc \
            build-essential \
            libpq-dev \
            curl \
            && rm -rf /var/lib/apt/lists/* && break || { \
            echo "Attempt $i: Package installation failed, retrying in 10 seconds..."; \
            sleep 10; \
            apt-get clean && \
            rm -rf /var/lib/apt/lists/*; \
        } \
    done

# Create non-root user
RUN groupadd -r connectuser && useradd -r -g connectuser connectuser

# Set working directory
WORKDIR /app

# Copy requirements and install Python dependencies with retry logic
COPY requirements.txt .
RUN set -ex && \
    # Configure pip for better reliability on fresh machines
    pip install --upgrade pip && \
    # Install dependencies with retry
    for i in 1 2 3; do \
        pip install \
            --trusted-host pypi.org \
            --trusted-host pypi.python.org \
            --trusted-host files.pythonhosted.org \
            --timeout 300 \
            --retries 5 \
            -r requirements.txt && break || { \
            echo "Attempt $i: pip install failed, clearing cache and retrying..."; \
            pip cache purge; \
            sleep 10; \
        } \
    done

# Copy application code
COPY . .

# Change ownership to non-root user
RUN chown -R connectuser:connectuser /app

# Switch to non-root user
USER connectuser

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Development command with auto-reload
CMD ["python", "-m", "uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"] 